    <string name="privacy_title">PRIVACY POLICY</string>
    <string name="privacy_security_title">DATA &amp; SECURITY ASSURANCE</string>
    <string name="privacy_on_device_title">On-Device Processing &amp; Local Storage</string>
    <string name="privacy_on_device_body">FlashMorse uses your device camera to analyze light pulses and can use your microphone when you choose voice input. Signal analysis and app logic run on-device. The app does not upload image frames, audio recordings, or message logs to remote cloud servers. Communication history may be stored locally on your device until you clear it.</string>
    <string name="privacy_permissions_title">HARDWARE PERMISSIONS USED</string>
    <string name="privacy_camera_permission_title">Camera Permission (CAMERA)</string>
    <string name="privacy_camera_permission_body">Required to capture ambient light pulses and decode flashing sequences in real-time. Video frames are analyzed locally and immediately discarded after processing.</string>
    <string name="privacy_audio_permission_title">Audio Permission (RECORD_AUDIO)</string>
    <string name="privacy_audio_permission_body">Optional and requested only when you choose voice-to-text transmission. Speech input is handled through the device speech recognition service available on the user’s device, which may vary by device and configuration.</string>
    <string name="privacy_contact_title">CONTACT &amp; INQUIRIES</string>
    <string name="privacy_contact_body">For questions about privacy, support, or developer information, please visit: %1$s</string>

    <string name="about_title">ABOUT FLASHMORSE</string>
    <string name="about_brand_mark">• --</string>
    <string name="about_mission_title">Mission</string>
    <string name="about_mission_body">FlashMorse is a real-time light signal communicator that uses camera-based optical analysis for Morse decoding and the device flashlight for optical transmission. It is designed to be responsive and practical for local optical communication experiments.</string>
